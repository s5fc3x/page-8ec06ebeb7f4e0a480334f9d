er-top-color:rgba(246,241,230,.2)}\n.plan ul{list-style:none;padding:0;margin:18px 0 0;font-size:14px}\n.plan ul li{padding:8px 0;border-top:1px solid var(--rule)}\n.plan .ribbon{position:absolute;top:-12px;right:18px;background:var(--amber);color:var(--ink);font-family:\"Inter\",sans-serif;font-size:11px;letter-spacing:.18em;padding:4px 10px;text-transform:uppercase}\n\n/* clients */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}\n.client-card{border:1px solid var(--ink);padding:22px;background:#fff;position:relative}\n.client-card h3{margin:0 0 6px;font-size:20px}\n.client-card .os{font-family:\"Inter\",sans-serif;font-size:11px;letter-spacing:.2em;color:var(--amber);text-transform:uppercase}\n.client-card p{margin:12px 0 14px;font-size:14.5px}\n.client-card ol{margin:0;padding-left:18px;font-size:14px;color:var(--ink-2)}\n.client-card ol li{margin-bottom:4px}\n.client-card .cta{display:inline-block;margin-top:16px;border:1px solid var(--ink);padding:6px 14px;font-family:\"Inter\",sans-serif;font-size:12px;letter-spacing:.16em;text-transform:uppercase}\n.client-card .cta:hover{background:var(--ink);color:var(--paper)}\n\n/* FAQ grouped */\n.faq-group{margin-bottom:34px}\n.faq-group .gtitle{font-family:\"Inter\",sans-serif;font-size:12px;letter-spacing:.26em;color:var(--amber);text-transform:uppercase;border-top:2px solid var(--ink);padding-top:14px;margin:0 0 14px}\n.faq-group details{border-bottom:1px dotted var(--rule);padding:12px 0}\n.faq-group summary{cursor:pointer;font-weight:600;list-style:none;display:flex;gap:12px;align-items:baseline}\n.faq-group summary::-webkit-details-marker{display:none}\n.faq-group summary::before{content:\"Q\";font-family:\"Inter\",sans-serif;color:var(--amber);font-size:13px;border:1px solid var(--amber);padding:1px 6px;border-radius:2px}\n.faq-group details[open] summary{color:var(--ink)}\n.faq-group .ans{margin:10px 0 0 38px;font-size:14.5px;color:var(--ink-2)}\n\n/* closing */\n.closing{background:var(--ink);color:var(--paper);padding:50px 0;text-align:center;border-bottom:none}\n.closing h2{font-size:28px;margin:0 0 12px}\n.closing p{max-width:640px;margin:0 auto 18px;font-size:15px;color:rgba(246,241,230,.85)}\n.closing a{border:1px solid var(--amber-2);color:var(--amber-2);padding:8px 22px;font-family:\"Inter\",sans-serif;font-size:12px;letter-spacing:.2em}\n.closing a:hover{background:var(--amber-2);color:var(--ink)}\n\nfooter{background:#06152a;color:rgba(246,241,230,.55);text-align:center;padding:22px 16px;font-family:\"Inter\",sans-serif;font-size:12px;letter-spacing:.14em}\n\n@media (max-width:880px){\n  .hero-grid{grid-template-columns:1fr;gap:24px}\n  .hero h1{font-size:40px}\n  .hero h1 .accent{font-size:26px}\n  .pullquote{font-size:18px}\n  .index-bar{grid-template-columns:repeat(3,1fr)}\n  .index-bar a{border-bottom:1px solid var(--rule)}\n  .qa-intro,.clients,.plans{grid-template-columns:1fr}\n  .big-card .content{max-width:100%}\n  .big-card .bignum{font-size:100px;bottom:-10px}\n  section{padding:44px 0}\n}\n</style><header class=\"masthead\">\n  <div class=\"wrap\">\n    <nav class=\"crumbs\" aria-label=\"面包屑\">\n      <ol>\n        <li><a href=\"#\">首页</a></li>\n        <li><a href=\"#\">网络服务</a></li>\n        <li><a href=\"#\">订阅方案</a></li>\n        <li><span>光速云 gscloud 套餐总览</span></li>\n      </ol>\n    </nav>\n    <nav class=\"index-bar\" aria-label=\"页面目录\">\n      <a href=\"#intro\"><span class=\"index-num\">01</span>品牌速览</a>\n      <a href=\"#how\"><span class=\"index-num\">02</span>使用流程</a>\n      <a href=\"#plans\"><span class=\"index-num\">03</span>订阅方案</a>\n      <a href=\"#clients\"><span class=\"index-num\">04</span>客户端</a>\n      <a href=\"#faq\"><span class=\"index-num\">05</span>常见问题</a>\n      <a href=\"#contact\"><span class=\"index-num\">06</span>联系</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n<section class=\"hero\" id=\"intro\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div>\n        <span class=\"brand-mark\">光速云 · gscloud · 订阅指南</span>\n        <h1>光速云(gscloud) · 先看明白,再决定要不要订阅。<span class=\"accent\">一份写给普通用户的网络套餐清单。</span></h1>\n        <p class=\"lede\">光速云 gscloud 提供从基础到团队的三档网络订阅,主打量级流量、多设备同开与按场景路由。本文用问答的方式,把套餐权益、设备数、流量节奏和上手步骤一次性整理出来,省去翻聊天记录的麻烦。</p>\n      </div>\n      <div class=\"cols\">\n        <p>光速云把订阅分成个人轻度、深度玩家、小型团队三档,差异落在月流量、同时在线设备数与可用节点类型上。</p>\n        <p>面向流媒体观看与日常浏览,可从基础版起步;对游戏延迟敏感或需要在多屏之间切换,旗舰版的原生流媒体与 IPLC 专线更贴合;而需要稳定高带宽并希望得到专属接待的,团队版接入企业路由与客户经理服务。</p>\n      </div>\n      <aside>\n        <blockquote class=\"pullquote\">\n          “买之前先看清单:每月需要多少 GB?家里有几台设备?对游戏延迟敏不敏感?”\n          <span class=\"who\">— gscloud 订阅建议</span>\n        </blockquote>\n        <div class=\"meta-box\">\n          <h3>本页速览</h3>\n          <dl>\n            <dt>品牌</dt><dd>光速云 gscloud</dd>\n            <dt>主题</dt><dd>订阅套餐与上手</dd>\n            <dt>方案数</dt><dd>3 档</dd>\n            <dt>更新</dt><dd>2025 · 现行版本</dd>\n            <dt>查阅方式</dt><dd>横向跳转阅读</dd>\n          </dl>\n        </div>\n      </aside>\n    </div>\n  </div>\n</section>\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"section-rule\">\n      <h2>从下单到连上,大致走这四步</h2>\n      <span class=\"tag\">USAGE FLOW · 02</span>\n      <p class=\"lead\">如果以前用过类似的网络工具,流程基本一致;不同的地方在于订阅与节点是分开管理的,套餐下单之后会拿到一串订阅地址。</p>\n    </div>\n\n    <article class=\"big-card\">\n      <span class=\"num\">STEP 01</span>\n      <span class=\"bignum\">01</span>\n      <div class=\"content\">\n        <h3>选一档适合自己的方案</h3>\n        <p>先评估家里或工作室一共有多少台设备同时上网,再估算一个月大约会用掉多少流量。基础版每月 100GB 给轻度浏览和偶尔看视频足够;旗舰版的 300GB 更适合经常看剧或游戏联机;团队版 1000GB 主要给多人共用。</p>\n        <ul>\n          <li>看月流量,不只看单月价格</li>\n          <li>按同时在线设备数挑档</li>\n          <li>对延迟敏感认准 IPLC 专线</li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"big-card\">\n      <span class=\"num\">STEP 02</span>\n      <span class=\"bignum\">02</span>\n      <div class=\"content\">\n        <h3>完成付款并记下订阅链接</h3>\n        <p>下单后,后台会生成一条以 http 或 https 开头的订阅地址,通常称作订阅链接。这条链接里包含你的账号、节点信息与到期日,后续导入客户端全靠它。建议把链接复制到自己的备忘录,而不是只依赖后台页面。</p>\n        <ul>\n          <li>订阅链接请勿外发</li>\n          <li>更换套餐后链接会自动更新</li>\n          <li>到期前可在后台手动续费</li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"big-card\">\n      <span class=\"num\">STEP 03</span>\n      <span class=\"bignum\">03</span>\n      <div class=\"content\">\n        <h3>下载对应平台的客户端</h3>\n        <p>光速云的订阅可以搭配多种第三方客户端使用,具体选择取决于操作系统。本页下方列出了常见桌面与移动端的导入步骤;建议同时在主力设备和备用设备上各装一份,以便切换。</p>\n        <ul>\n          <li>桌面端优先选 v2rayN / Clash Verge</li>\n          <li>移动端常用 Shadowrocket / v2rayNG</li>\n          <li>客户端版本尽量保持最新</li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"big-card\">\n      <span class=\"num\">STEP 04</span>\n      <span class=\"bignum\">04</span>\n      <div class=\"content\">\n        <h3>导入订阅并按场景选节点</h3>\n        <p>把订阅链接粘贴到客户端的“订阅设置”或“Profiles”项,触发一次更新,即可看到当前可用节点列表。日常浏览选普通节点即可;看流媒体挑带流媒体标签的;游戏联机或远程办公则进入 IPLC 专线组。</p>\n        <ul>\n          <li>导入后等列表刷新完成</li>\n          <li>首次使用建议测速一次</li>\n          <li>遇到连不上先切换节点</li>\n        </ul>\n      </div>\n    </article>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"section-rule\">\n      <h2>三档套餐,按场景阶梯递进</h2>\n      <span class=\"tag\">PLANS · 03</span>\n      <p class=\"lead\">价格从低到高逐档叠加,权益也逐档释放。所有套餐均支持按月或按年付费,按年付一次性结算,可减少每月重复操作。</p>\n    </div>\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <span class=\"sub\">ENTRY · 01</span>\n        <h3>基础版</h3>\n        <p>面向个人轻度使用,以浏览与偶尔观影为主。</p>\n        <div class=\"price\">¥15<small>/月</small></div>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <p class=\"annual\">按年付仅需 ¥150/年</p>\n      </article>\n\n      <article class=\"plan featured\">\n        <span class=\"ribbon\">推荐</span>\n        <span class=\"sub\">PRO · 02</span>\n        <h3>旗舰版</h3>\n        <p>面向重度使用者,覆盖游戏、流媒体与多设备切换。</p>\n        <div class=\"price\">¥35<small>/月</small></div>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <p class=\"annual\">按年付仅需 ¥350/年</p>\n      </article>\n\n      <article class=\"plan\">\n        <span class=\"sub\">TEAM · 03</span>\n        <h3>团队版</h3>\n        <p>面向小型团队与工作室,提供企业级路由与对接。</p>\n        <div class=\"price\">¥85<small>/月</small></div>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <p class=\"annual\">按年付仅需 ¥850/年</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"section-rule\">\n      <h2>客户端要怎么导入订阅?</h2>\n      <span class=\"tag\">CLIENTS · 04</span>\n      <p class=\"lead\">以下步骤给出常见操作系统下的通用做法。具体菜单名称会随客户端版本变化,但大逻辑一致:安装 → 粘贴订阅 → 更新 → 选节点。</p>\n    </div>\n    <div class=\"clients\">\n      <article class=\"client-card\">\n        <span class=\"os\">DESKTOP · WINDOWS / MACOS</span>\n        <h3>桌面端:Clash 系列</h3>\n        <p>以 Clash Verge 或同类 GUI 客户端为例,把订阅链接作为远程配置导入,刷新后即可看到节点分组。</p>\n        <ol>\n          <li>下载客户端并完成解压安装</li>\n          <li>打开 Profiles / 配置 一栏</li>\n          <li>选择“从 URL 导入”,粘贴订阅链接</li>\n          <li>点击立即更新,等待节点加载</li>\n          <li>在 Proxies 选项卡里挑节点启用</li>\n        </ol>\n        <a class=\"cta\" href=\"#\">下载说明</a>\n      </article>\n\n      <article class=\"client-card\">\n        <span class=\"os\">MOBILE · IOS / ANDROID</span>\n        <h3>移动端:Shadowrocket / v2rayNG</h3>\n        <p>iOS 上常用 Shadowrocket,安卓上常用 v2rayNG。两者都支持一键粘贴订阅,更新后自动列出节点。</p>\n        <ol>\n          <li>在应用商店或官网获取客户端</li>\n          <li>进入 “订阅” 或 “Subscriptions”</li>\n          <li>点击 + 号,粘贴订阅链接</li>\n          <li>完成更新,在主界面选择节点</li>\n          <li>打开连接开关,确认图标变色</li>\n        </ol>\n        <a class=\"cta\" href=\"#\">下载说明</a>\n      </article>\n\n      <article class=\"client-card\">\n        <span class=\"os\">CLI · LINUX / NAS</span>\n        <h3>命令行与旁路由场景</h3>\n        <p>如果跑在 OpenWrt 路由器或 NAS 上,通常通过订阅转换服务得到一份 YAML 文件,再放到对应目录。</p>\n        <ol>\n          <li>在后台拿到原始订阅链接</li>\n          <li>使用订阅转换得到 Clash 配置</li>\n          <li>把配置文件放入 /etc 目录</li>\n          <li>重启 clash 守护进程</li>\n          <li>局域网设备网关指向路由器 IP</li>\n        </ol>\n        <a class=\"cta\" href=\"#\">部署说明</a>\n      </article>\n\n      <article class=\"client-card\">\n        <span class=\"os\">EDGE · TV / 浏览器</span>\n        <h3>电视端与浏览器插件</h3>\n        <p>智能电视一般需要借助路由器侧代理,浏览器可使用 SwithyOmega 等插件做按需切换。</p>\n        <ol>\n          <li>电视连接已开启代理的路由器</li>\n          <li>浏览器安装代理切换插件</li>\n          <li>导入同一份订阅配置</li>\n          <li>按域名设置自动切换规则</li>\n          <li>日常浏览即可走代理通道</li>\n        </ol>\n        <a class=\"cta\" href=\"#\">参考方案</a>\n      </article>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"section-rule\">\n      <h2>订阅前常被问到的几件事</h2>\n      <span class=\"tag\">FAQ · 05</span>\n      <p class=\"lead\">FAQ 按主题分成四组:套餐与计费、设备与流量、节点与体验、技术与售后。点击问题可以展开答案。</p>\n    </div>\n\n    <div class=\"qa-intro\">\n      <p>光速云的订阅规则经常被混在一些零散的聊天记录里,这里把高频疑问整理成段落,希望能一次性说清楚。如果你找到的问题不在列表里,可以在底部联系栏留言。</p>\n      <p>FAQ 中提到的“套餐”“节点”“专线”等说法都来自本页前面的章节描述,术语如有冲突,以套餐列表与本节为准。</p>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3 class=\"gtitle\">套餐与计费</h3>\n      <details>\n        <summary>套餐之间可以中途升降级吗?</summary>\n        <p class=\"ans\">可以。在订阅有效期内,进入后台的“我的套餐”页面选择升档或降档,差价会按剩余天数折算。升档立即生效,降档通常在下一计费周期开始时切换。</p>\n      </details>\n      <details>\n        <summary>按月付和按年付的流量是分开算的吗?</summary>\n        <p class=\"ans\">不分开。无论按月还是按年付费,套餐对应的月流量额度是每个月重置的。按年付只是把 12 个月合并结算,流量仍按自然月刷新。</p>\n      </details>\n      <details>\n        <summary>续费会自动扣款吗?</summary>\n        <p class=\"ans\">默认不开启自动续费。到期前系统会提醒,如未手动续费,服务会保留一小段宽限期,之后停机。建议在到期前 3 天处理。</p>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3 class=\"gtitle\">设备与流量</h3>\n      <details>\n        <summary>“支持 3 台设备同时在线”是什么意思?</summary>\n        <p class=\"ans\">指的是同一时间可以有多少个客户端实例保持连接。比如手机、电脑、平板同时挂着,就算 3 台;再多开一台就会提示并发超限。</p>\n      </details>\n      <details>\n        <summary>流量用完了会怎样?</summary>\n        <p class=\"ans\">当月流量耗尽后,客户端仍然可以连接,但会被路由到限速节点,普通浏览没问题,视频与下载会明显变慢。新一个月开始后恢复正常额度。</p>\n      </details>\n      <details>\n        <summary>100GB / 300GB 够用吗?</summary>\n        <p class=\"ans\">粗略估算:在线标清视频约 1–2GB / 小时,高清 4K 可达 5GB 以上。仅日常浏览和偶尔看剧,100GB 通常足够;重度追剧建议直接上 300GB。</p>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3 class=\"gtitle\">节点与体验</h3>\n      <details>\n        <summary>IPLC 专线和普通线路区别大吗?</summary>\n        <p class=\"ans\">IPLC 专线在跨境段走企业级通道,波动相对更小,适合对延迟敏感的游戏和远程办公。普通线路则用公共中转,高峰期可能有波动,但价格更低。</p>\n      </details>\n      <details>\n        <summary>流媒体解锁是怎么实现的?</summary>\n        <p class=\"ans\">套餐内标注的“原生流媒体解锁”,指的是对应节点的出口 IP 被相应平台识别为本地住宅或商用段,可正常观看已订阅内容。具体可用清单随平台调整。</p>\n      </details>\n      <details>\n        <summary>为什么有时候要手动切换节点?</summary>\n        <p class=\"ans\">跨境网络状况会随时间变化。当某个节点出现延迟升高或被目标网站限速时,切换到同区域另一个节点通常就能恢复,客户端测速页可以辅助判断。</p>\n      </details>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3 class=\"gtitle\">技术与售后</h3>\n      <details>\n        <summary>订阅链接泄露了怎么办?</summary>\n        <p class=\"ans\">立刻在后台重置订阅链接,旧链接会失效。同时建议检查账号近期登录记录,如有异常设备,在“会话管理”里踢出。</p>\n      </details>\n      <details>\n        <summary>工单一般多久回复?</summary>\n        <p class=\"ans\">旗舰版与团队版提供 7x24 优先工单支持,通常数小时内有初步响应;基础版在工作时段处理,首次回复一般在当天内。</p>\n      </details>\n      <details>\n        <summary>支持哪些付款方式?</summary>\n        <p class=\"ans\">常见的方式包括在线支付与对公转账,具体可用渠道在下单页面会列出。团队版如果需要发票或合同,可以联系专属客户经理处理。</p>\n      </details>\n    </div>\n  </div>\n</section>\n\n<section class=\"closing\" id=\"contact\">\n  <div class=\"wrap\">\n    <h2>没找到答案?把问题留在联系栏</h2>\n    <p>本页尽量覆盖订阅前会问到的问题,如果还有未列出的疑问,可以在联系栏留言,我们会把高频问题补回到 FAQ 里。</p>\n    <a href=\"#\">前往联系页</a>\n  </div>\n</section>\n</main>\n\n<footer>\n  <div class=\"wrap\">光速云 gscloud · 订阅与上手指南 · 仅整理当前套餐与常见问题</div>\n</footer>",
